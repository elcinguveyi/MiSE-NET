def mean_pm_std(x):
    x = np.asarray(x, dtype=float)
    return f"{x.mean():.4f} ± {x.std(ddof=1):.4f}"  

# SE BLOCK
class SEBlock1D(Layer):
    def __init__(self, channels, ratio=16, **kwargs):
        super().__init__(**kwargs)
        self.gap = GlobalAveragePooling1D()
        self.fc1 = Dense(max(channels // ratio, 1), activation="relu")
        self.fc2 = Dense(channels, activation="sigmoid")
        self.reshape = Reshape((1, channels))
        self.multiply = Multiply()

    def call(self, inputs):
        se = self.gap(inputs)
        se = self.fc1(se)
        se = self.fc2(se)
        se = self.reshape(se)
        return self.multiply([inputs, se])


# ======================================
# 2) EXPERT + MoE
# ======================================
class Expert(Layer):
    def __init__(self, units, ratio=16, **kwargs):
        super().__init__(**kwargs)
        self.dense = Dense(units, activation="relu")
        self.se = SEBlock1D(units, ratio=ratio)

    def call(self, inputs):
        x = self.dense(inputs)
        x = tf.expand_dims(x, axis=1)
        x = self.se(x)
        return tf.squeeze(x, axis=1)


class MoE(Layer):
    def __init__(self, num_experts=4, units=128, ratio=16, **kwargs):
        super().__init__(**kwargs)
        self.experts = [Expert(units, ratio=ratio) for _ in range(num_experts)]
        self.gate = Dense(num_experts, activation="softmax")

    def call(self, inputs):
        gates = self.gate(inputs)
        expert_outs = [expert(inputs) for expert in self.experts]
        expert_outs = tf.stack(expert_outs, axis=1)
        gates = tf.expand_dims(gates, axis=-1)
        return tf.reduce_sum(expert_outs * gates, axis=1)


# ======================================
# 3) MODEL FACTORY
# ======================================
def create_model(input_dim):
    inputs = Input(shape=(input_dim, 1))

    x = Conv1D(64, 7, activation="relu", padding="same")(inputs)
    x = MaxPooling1D(2)(x)
    x = SEBlock1D(64)(x)

    x = Conv1D(64, 5, activation="relu", padding="same")(x)
    x = MaxPooling1D(2)(x)
    x = SEBlock1D(64)(x)

    x = Flatten()(x)
    x = MoE(num_experts=4, units=128, ratio=16)(x)

    x = Dense(256, activation="relu")(x)
    outputs = Dense(1, activation="sigmoid")(x)

    model = Model(inputs, outputs)
    model.compile(
        optimizer="adam",
        loss="binary_crossentropy",
        metrics=["accuracy"]
    )
    return model


